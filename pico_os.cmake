# pico_os.cmake - entry point for applications built on top of this repository.
#
# Check out examples on how to use or set up a repo via template scripts
#
set(PICO_OS_PATH "${CMAKE_CURRENT_LIST_DIR}" CACHE INTERNAL "Path to the pico OS repository")

if ((NOT DEFINED PICO_BOARD) AND (DEFINED ENV{PICO_BOARD}))
    set(PICO_BOARD "$ENV{PICO_BOARD}")
endif()

if (PICO_BOARD STREQUAL "linux")
    set(PICO_OS_PLATFORM "linux" CACHE INTERNAL "pico or linux, from PICO_BOARD")
else()
    set(PICO_OS_PLATFORM "pico" CACHE INTERNAL "pico or linux, from PICO_BOARD")
endif()

# pico_os_web_resource(): web pages packed into the firmware.
include("${PICO_OS_PATH}/web/web.cmake")

function(pico_os_git_version dir output)
    execute_process(COMMAND git -c safe.directory=* -C "${dir}" describe --always --dirty --tags
                    OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
    if ((NOT rc EQUAL 0) OR (version STREQUAL ""))
        set(version "unknown")
    endif()
    set(${output} "${version}" PARENT_SCOPE)
endfunction()

function(pico_os_version_header)
    pico_os_git_version("${CMAKE_SOURCE_DIR}" app_version)
    pico_os_git_version("${PICO_OS_PATH}" os_version)

    set(PICO_OS_VERSION_INCLUDE_DIR "${CMAKE_BINARY_DIR}/os/version" CACHE INTERNAL "Where pico_os_version.h is generated")

    file(CONFIGURE OUTPUT "${PICO_OS_VERSION_INCLUDE_DIR}/pico_os_version.h" CONTENT
"// Generated by pico_os.cmake - do not edit.
#pragma once

#define PICO_OS_APP_VERSION \"${app_version}\"
#define PICO_OS_OS_VERSION \"${os_version}\"
" @ONLY)

    message(STATUS "Version: app ${app_version}, os ${os_version}")
endfunction()

include("${PICO_OS_PATH}/platform/${PICO_OS_PLATFORM}/pico_os_${PICO_OS_PLATFORM}.cmake")
